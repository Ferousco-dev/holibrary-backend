# Production environment. Set these in the Render dashboard, never in a file.
#
# Everything here is a secret except where noted. This file records the shape,
# not the values.

ENV=production
PORT=10000

# Neon. Copy the POOLED connection string: Render's free instance opens and
# closes connections as it sleeps and wakes, and the pooler absorbs that.
DATABASE_URL=postgresql://USER:PASSWORD@ep-xxx-pooler.REGION.aws.neon.tech/holibrary?sslmode=require

# Upstash. The rediss:// scheme, not redis://: this crosses the public internet.
REDIS_URL=rediss://default:PASSWORD@HOST.upstash.io:6379

# At least 32 characters. Render generates this; do not reuse one from anywhere.
JWT_SECRET=

# Resend, sending from a domain already verified in your account.
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxx
MAIL_FROM=holibrary@appmd.dev

# The Vercel frontend, exactly. No wildcard, no trailing slash.
CORS_ORIGINS=https://holibrary.vercel.app

# True only because Render terminates TLS in front of this service and the
# origin is not directly reachable.
TRUST_PROXY_HEADERS=true

# Must stay false. The service refuses to start in production if it is true.
SEED_DEMO_DATA=false

OPENLIBRARY_BASE_URL=https://openlibrary.org
