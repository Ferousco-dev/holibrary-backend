# Copy to .env and fill in. NEVER commit .env (NFR-015).

# --- server ---
PORT=8080
ENV=development

# --- database: Neon PostgreSQL (DEC-011) ---
DATABASE_URL=postgres://user:password@host.neon.tech/holibrary?sslmode=require

# --- redis: Upstash, used for rate limiting and the outbox worker (DES-008) ---
# Without it the limiter falls back to an in-process counter, which is lost on
# restart and does not coordinate across instances.
REDIS_URL=rediss://default:password@host.upstash.io:6379

# --- proxy headers ---
# Set to true ONLY when every request provably reaches this service through a
# proxy that overwrites CF-Connecting-IP / X-Forwarded-For. Anyone reaching the
# origin directly can forge them, which would let an attacker dodge the per-IP
# limit or forge a victim's address to lock them out. Default false.
TRUST_PROXY_HEADERS=false

# --- auth (NFR-003) ---
JWT_SECRET=change-me-to-a-long-random-string
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=168h

# --- CORS: explicit origins only, no wildcard (NFR-016) ---
CORS_ORIGINS=http://localhost:5173

# --- notifications (DEC-012). Resend needs a DNS-verified domain: RSK-002 ---
RESEND_API_KEY=
MAIL_FROM=library@example.edu.ng
FCM_PROJECT_ID=
FCM_CREDENTIALS_JSON=

# --- where email links point ---
# The reset link in a password email is built from this. Set it to wherever the
# frontend actually is: a link to the wrong host is worse than no link, because
# the member cannot tell it is wrong.
FRONTEND_URL=https://library.appmd.dev

# --- external bibliographic source, seeding only (DEC-007) ---
OPENLIBRARY_BASE_URL=https://openlibrary.org
